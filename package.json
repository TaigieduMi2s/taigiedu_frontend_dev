{
  "name": "taiwanese",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github": "set VITE_BASE_PATH=/taiwaneseOMG/&& vite build",
    "build:prod": "set VITE_BASE_PATH=/&& vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.js",
    "test:e2e:ui": "npx playwright test --config=tests/e2e/playwright.config.js --ui",
    "test:e2e:smoke": "npx playwright test --config=tests/e2e/playwright.config.js --project=smoke",
    "test:e2e:features": "npx playwright test --config=tests/e2e/playwright.config.js --project=features",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-table": "^8.21.3",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.17.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "vite": "^7.3.6",
    "wrangler": "^4.123.0"
  }
}
